{
  "references": [
    {
      "id": "goal",
      "kind": "north-star",
      "path": "docs/GOAL.md",
      "when": "任何跨 crate、core、driver、port、平台边界任务开局必读"
    },
    {
      "id": "roadmap-p0",
      "kind": "live-ledger",
      "path": "docs/ROADMAP.md",
      "when": "开局确认 P0 活账和当前阻塞"
    },
    {
      "id": "operating",
      "kind": "runbook",
      "path": "docs/harness/OPERATING.md",
      "when": "决定调哪个 skill/workflow/gate 时读取"
    },
    {
      "id": "harness-index",
      "kind": "constraint-index",
      "path": "docs/harness/README.md",
      "when": "新增/修改约束或审查 HX-C 时读取"
    },
    {
      "id": "decisions",
      "kind": "adr",
      "path": "docs/harness/decisions.md",
      "when": "wasm/ADR/架构争议需要拍板依据时读取"
    },
    {
      "id": "commit-convention",
      "kind": "commit",
      "path": "docs/COMMIT_CONVENTION.md",
      "when": "准备提交或报告提交策略时读取"
    },
    {
      "id": "projection-schema",
      "kind": "contract",
      "path": "crates/helix-im/docs/projection-schema.md",
      "when": "触碰 im:__bus__、投影 payload、EventSink/BatchSink 时读取"
    },
    {
      "id": "external-host-instrumentation",
      "kind": "recipe",
      "path": "crates/helix-driver-host/docs/external-host-instrumentation-recipe.md",
      "when": "loopforge/Tauri 接入 RecordingSink 或投影录放时读取"
    },
    {
      "id": "full-map-index",
      "kind": "source-truth-index",
      "path": "crates/helix-im/docs/csesapi-migration/full-map/00-README-index.md",
      "when": "csesapi 迁移和能力缺口对账读取"
    },
    {
      "id": "gate-v2-local-rules",
      "kind": "agent-boundary",
      "path": "docs/interaction-frame-v2-全量替换-按UC/AGENTS.md",
      "when": "逐 Gate V2 总控和 handoff 任务必读"
    },
    {
      "id": "gate-test-local-rules",
      "kind": "agent-boundary",
      "path": "crates/helix-im/tests/AGENTS.md",
      "when": "逐 Gate ScenarioRunner、full-flow 或 producer test 必读"
    },
    {
      "id": "gate-fixture-local-rules",
      "kind": "agent-boundary",
      "path": "crates/helix-im/tests/fixtures/AGENTS.md",
      "when": "canonical Fixture、provenance 或跨仓同步必读"
    }
  ]
}
