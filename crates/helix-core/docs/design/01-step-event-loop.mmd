%% helix-core — step 事件循环（ExecutionShell::step 的同步纯函数路由）
%% 真源：src/engine.rs (step / register_effects_to_maps) + src/module_host.rs (dispatch_*)
%% 关联：HX-C001(零运行时) · CLAUDE.md §0 sans-IO · 不变量 step() 零 await/IO/spawn
flowchart TD
    classDef driver fill:#e8f0fe,stroke:#4285f4,color:#1a1a1a
    classDef core fill:#e6f4ea,stroke:#34a853,color:#1a1a1a
    classDef route fill:#fef7e0,stroke:#fbbc04,color:#1a1a1a
    classDef module fill:#fce8e6,stroke:#ea4335,color:#1a1a1a

    DRV["driver engine_loop<br/>（兑现上一轮 Effect → 包成下一个 Tick）"]:::driver
    IN["✅ shell.step(tick, now_ms)<br/>严格同步 · 零 await/IO/spawn"]:::core
    CLR["✅ scratch.clear()<br/>跨 step 复用 EffectSink，零分配（轴①）"]:::core

    DRV -->|"喂入 Tick + now_ms（Clock 注入读数）"| IN
    IN --> CLR --> MATCH{"match &tick<br/>6 个 Tick 变体"}:::route

    %% ── 路由分支 1：内容路由（accepts 线性扫描）──
    MATCH -->|"Inbound / Command / Connected / Disconnected"| SCAN["✅ host.dispatch_inbound<br/>线性扫描 modules，first-match accepts()<br/>（预期模块数 <10，实践 O(1)）"]:::route
    SCAN --> HIT{"命中某模块?"}:::route
    HIT -->|"Some(idx)"| H1["✅ Module::handle(&tick, now_ms, out)"]:::module
    HIT -->|"None"| NOP["⚠️ tracing::debug 无模块接受<br/>（未知帧 drop / 配置错误，不报错）"]:::route

    %% ── 路由分支 2：PortReply 定向（corr_map O(1)）──
    MATCH -->|"PortReply{corr, outcome}"| CM["✅ corr_map.consume(corr)<br/>O(1) HashMap 取出并移除（防 stale 积累）"]:::route
    CM --> CMHIT{"corr 已注册?"}:::route
    CMHIT -->|"Some(idx)"| H2["✅ dispatch_reply(idx) → Module::handle"]:::module
    CMHIT -->|"None"| CMWARN["⚠️ tracing::warn unknown correlation<br/>（PersistFire 误发 / 模块停后迟到响应，静默忽略）"]:::route

    %% ── 路由分支 3：Timer 定向（timer_map O(1)）──
    MATCH -->|"Timer(id)"| TM["✅ timer_map.peek(id)<br/>O(1) 只读不移除（recurring 可 re-arm）"]:::route
    TM --> TMHIT{"timer_id 已注册?"}:::route
    TMHIT -->|"Some(idx)"| H3["✅ dispatch_reply(idx) → Module::handle"]:::module
    TMHIT -->|"None"| TMDBG["⚠️ tracing::debug unknown timer<br/>（CancelTimer 后迟到触发，静默忽略）"]:::route

    %% ── 汇合：handle 吐 Effect → 注册 corr/timer → 返回切片 ──
    H1 --> OUT["✅ out.push(Effect)<br/>模块只声明意图，零 I/O"]:::module
    H2 --> OUT
    H3 --> OUT
    OUT --> REG["✅ register_effects_to_maps(idx, start=0)<br/>扫新增 Effect 注册 corr/timer 路由<br/>Persist/Http/Request → corr_map.register<br/>ScheduleTimer → timer_map.register<br/>CancelTimer → timer_map.remove<br/>HttpFire/Emit/PersistFire → 不注册（无 corr）"]:::core

    REG --> RET["✅ Ok(&[Effect])<br/>借 scratch，下次 step 前有效"]:::core
    NOP --> RET
    CMWARN --> RET
    TMDBG --> RET
    RET -->|"driver 异步兑现 Effect，结果包成下个 Tick 回灌"| DRV
