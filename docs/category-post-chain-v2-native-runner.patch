+#[cfg(test)]
+mod transport_tests {
+    use super::*;
+    use helix_core::tick::ReplyBytes;
+    /// Real trace dispatch/reply hooks must associate mode/view and leave requests untouched.
+    fn observe(evidence: &Evidence, corr: u64, path: &str, body: Value) {
+        let mut req = HttpRequest {
+            method: "POST".to_owned(),
+            url: format!("http://127.0.0.1:12345/api/cses/{path}"),
+            headers: vec![],
+            body: Some(Bytes::from(serde_json::to_vec(&body).unwrap())),
+        };
+        let before = req.body.clone();
+        evidence.on_http_dispatch(Some(Correlation::from_raw(corr)), &mut req);
+        assert_eq!(req.body, before);
+        let reply = json!({"status":200,"body":base64::engine::general_purpose::STANDARD.encode(br#"{"status":"SUCCESS","data":{}}"#)});
+        evidence.on_tick_start(
+            &Tick::PortReply {
+                corr: Correlation::from_raw(corr),
+                outcome: PortOutcome::Ok(ReplyBytes(Bytes::from(
+                    serde_json::to_vec(&reply).unwrap(),
+                ))),
+            },
+            None,
+        );
+    }
+    /// Nine successful paths are insufficient without all eleven semantic actions and all three get views.
+    #[test]
+    fn v2_requires_eleven_semantics_nine_paths_and_three_views() {
+        let evidence = Evidence::default();
+        for (i, path) in [
+            "capabilities",
+            "create",
+            "update-draft",
+            "publish",
+            "append",
+            "close",
+            "retract",
+            "reconcile",
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            observe(
+                &evidence,
+                i as u64,
+                &format!("post-chain/{path}"),
+                json!({"mode":"CATEGORY"}),
+            );
+        }
+        observe(
+            &evidence,
+            9,
+            "post-chain/get",
+            json!({"mode":"CATEGORY","view":"card"}),
+        );
+        assert_eq!(
+            evidence.missing_routes(),
+            vec!["my-participation", "entries"]
+        );
+        observe(
+            &evidence,
+            10,
+            "post-chain/get",
+            json!({"mode":"CATEGORY","view":"mine"}),
+        );
+        observe(
+            &evidence,
+            11,
+            "post-chain/get",
+            json!({"mode":"CATEGORY","view":"entries"}),
+        );
+        assert!(evidence.missing_routes().is_empty());
+        let trace = evidence.snapshot();
+        assert_eq!(trace["successfulHttpPaths"].as_array().unwrap().len(), 9);
+        assert_eq!(
+            trace["successfulGetViews"],
+            json!(["card", "entries", "mine"])
+        );
+        assert_eq!(trace["categoryTransportValid"], true);
+        // A later legacy request invalidates the run even after all successful semantics exist.
+        observe(
+            &evidence,
+            12,
+            "category-chain/get",
+            json!({"mode":"CATEGORY"}),
+        );
+        assert_eq!(evidence.snapshot()["categoryTransportValid"], false);
+    }
+    /// HTTP SUCCESS cannot hide an absent/wrong mode, absent/wrong get view, or a legacy URL.
+    #[test]
+    fn v2_rejects_wrong_modes_views_and_legacy_urls() {
+        for (path, body) in [
+            ("post-chain/get", json!({"view":"mine"})),
+            ("post-chain/get", json!({"mode":"TEXT","view":"mine"})),
+            ("post-chain/get", json!({"mode":null,"view":"mine"})),
+            ("post-chain/get", json!({"mode":"CATEGORY"})),
+            (
+                "post-chain/get",
+                json!({"mode":"CATEGORY","view":"unknown"}),
+            ),
+            (
+                "category-chain/my-participation",
+                json!({"mode":"CATEGORY"}),
+            ),
+        ] {
+            let evidence = Evidence::default();
+            observe(&evidence, 1, path, body);
+            assert_eq!(evidence.missing_routes().len(), 11);
+            assert_eq!(evidence.snapshot()["categoryTransportValid"], false);
+        }
+    }
+}
