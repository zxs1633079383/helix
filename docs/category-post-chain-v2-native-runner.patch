+/// Classify actual outbound v2 path/mode/view into eleven semantic actions without retaining payloads.
+fn category_transport(req: &HttpRequest) -> Value {
+    let url = url::Url::parse(&req.url).ok();
+    let path = url.as_ref().map(|u| u.path()).unwrap_or("");
+    let old = path.contains("/category-chain/");
+    let shared = path.contains("/post-chain/");
+    let body = req
+        .body
+        .as_ref()
+        .filter(|b| b.len() <= 256 * 1024)
+        .and_then(|b| serde_json::from_slice::<Value>(b).ok())
+        .unwrap_or(Value::Null);
+    let mode = match body.get("mode") {
+        Some(Value::String(v)) if v == "CATEGORY" => "CATEGORY",
+        Some(Value::String(v)) if v == "TEXT" => "TEXT",
+        None => "MISSING",
+        _ => "INVALID",
+    };
+    let view = match body.get("view") {
+        Some(Value::String(v)) if v == "card" => Some("card"),
+        Some(Value::String(v)) if v == "mine" => Some("mine"),
+        Some(Value::String(v)) if v == "entries" => Some("entries"),
+        None => None,
+        _ => Some("INVALID"),
+    };
+    let safe_path = match path {
+        "/api/cses/post-chain/capabilities" => "capabilities",
+        "/api/cses/post-chain/create" => "create",
+        "/api/cses/post-chain/update-draft" => "update-draft",
+        "/api/cses/post-chain/publish" => "publish",
+        "/api/cses/post-chain/append" => "append",
+        "/api/cses/post-chain/get" => "get",
+        "/api/cses/post-chain/close" => "close",
+        "/api/cses/post-chain/retract" => "retract",
+        "/api/cses/post-chain/reconcile" => "reconcile",
+        _ => "other",
+    };
+    let action = if req.method == "POST" && mode == "CATEGORY" {
+        match (safe_path, view) {
+            ("capabilities", None) => "capabilities",
+            ("create", None) => "create-draft",
+            ("update-draft", None) => "update-draft",
+            ("publish", None) => "publish",
+            ("append", None) => "set-participation",
+            ("get", Some("card")) => "get",
+            ("get", Some("mine")) => "my-participation",
+            ("get", Some("entries")) => "entries",
+            ("close", None) => "close",
+            ("retract", None) => "retract",
+            ("reconcile", None) => "reconcile",
+            _ => "other",
+        }
+    } else {
+        "other"
+    };
+    json!({"action":action,"path":if safe_path=="other" { "other".to_owned() } else { format!("/api/cses/post-chain/{safe_path}") },
+        "mode":mode,"view":view,"legacyCategoryUrl":old,
+        "categoryTransportViolation": old || ((shared || mode=="CATEGORY") && action=="other")})
+}
