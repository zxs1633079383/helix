+/// Drive only the real pre-HTTP storage barrier (publish identity); never synthesize authority.
+fn category_mode_http(alias: &str, args: Value) -> (String, Value) {
+    let mut h = Harness::new_with_identity(&[1], "user-a", "tenant-a", "", "", "");
+    let cmd = helix_im::client_api::build_command(alias, &serde_json::to_vec(&args).unwrap()).unwrap();
+    h.step(Tick::Command(cmd), 1000);
+    let mut store = Store::new();
+    for _ in 0..4 {
+        assert!(!h.sink.as_slice().iter().any(|e| matches!(e, Effect::Emit { .. })));
+        if let Some((url, body)) = h.sink.as_slice().iter().find_map(|e| match e {
+            Effect::Http { req, .. } => Some((req.url.to_string(), serde_json::from_slice(req.body.as_ref().unwrap()).unwrap())),
+            _ => None,
+        }) { return (url, body); }
+        let (corr, body) = h.sink.as_slice().iter().find_map(|e| match e {
+            Effect::Persist { corr, ops } | Effect::PersistAtomic { corr, ops } => Some((*corr, storage_reply(ops, &mut store))),
+            _ => None,
+        }).expect("command must dispatch HTTP or its publish identity barrier");
+        h.step(Tick::PortReply { corr, outcome:PortOutcome::Ok(ReplyBytes(Bytes::from(serde_json::to_vec(&body).unwrap()))) }, 1001);
+    }
+    panic!("publish identity did not lead to HTTP");
+}
