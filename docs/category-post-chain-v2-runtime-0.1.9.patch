+/// All eleven semantic commands share post-chain transport; get views and string CAS stay distinct.
+#[test]
+fn post_chain_mode_v2_maps_all_category_commands() {
+    let scope = json!({"channelId":cid(1),"chainId":"chain-a","req_id":"read-mode"});
+    let draft = json!({"channelId":cid(1),"title":"活动","description":"","example":"",
+        "deadlineAt":1789113600000_i64,"audience":{"mode":"CHANNEL_SNAPSHOT"},
+        "categories":[{"clientId":"a","name":"室内"},{"clientId":"b","name":"户外"}],"clientMutationId":"draft-mode"});
+    let mut update = draft.clone();
+    update["chainId"] = json!("chain-a");
+    update["expectedDefinitionRevision"] = json!("9007199254740993");
+    let cases = [
+        ("capabilities", json!({"req_id":"cap-mode"}), "capabilities", None),
+        ("create_draft", draft, "create", None),
+        ("update_draft", update, "update-draft", None),
+        ("publish", json!({"channelId":cid(1),"chainId":"chain-a","expectedDefinitionRevision":"9007199254740993","clientMutationId":"publish-mode"}), "publish", None),
+        ("get", scope.clone(), "get", Some("card")),
+        ("get_mine", scope.clone(), "get", Some("mine")),
+        ("entries", json!({"channelId":cid(1),"chainId":"chain-a","categoryId":"a","cursor":"opaque:cursor","limit":5,"req_id":"entries-mode"}), "get", Some("entries")),
+        ("set_participation", json!({"channelId":cid(1),"chainId":"chain-a","expectedParticipationRevision":"9007199254740993","selections":[{"categoryId":"a","content":"一"},{"categoryId":"b","content":"二"}],"clientMutationId":"set-mode"}), "append", None),
+        ("close", json!({"channelId":cid(1),"chainId":"chain-a","expectedRevision":"9007199254740993","clientMutationId":"close-mode"}), "close", None),
+        ("retract", json!({"channelId":cid(1),"chainId":"chain-a","expectedRevision":"9007199254740993","clientMutationId":"retract-mode"}), "retract", None),
+        ("reconcile", json!({"channelId":cid(1),"chainId":"chain-a","clientMutationId":"set-mode","req_id":"reconcile-mode"}), "reconcile", None),
+    ];
+    for (suffix, args, route, view) in cases {
+        let (url, body) = category_mode_http(&format!("im_category_chain_{suffix}"), args);
+        assert!(url.ends_with(&format!("/post-chain/{route}")), "{suffix}: {url}");
+        assert_eq!(body["mode"], "CATEGORY", "{suffix}");
+        assert_eq!(body.get("view").and_then(Value::as_str), view, "{suffix}");
+        assert!(body.get("req_id").is_none() && body.get("reqId").is_none());
+        if suffix == "capabilities" { assert_eq!(body, json!({"mode":"CATEGORY"})); }
+        if suffix == "get" || suffix == "get_mine" {
+            assert_eq!(body, json!({"mode":"CATEGORY","view":view,"channelId":cid(1),"chainId":"chain-a"}));
+        }
+        if suffix == "entries" {
+            assert_eq!(body, json!({"mode":"CATEGORY","view":"entries","channelId":cid(1),"chainId":"chain-a","categoryId":"a","cursor":"opaque:cursor","limit":5}));
+        }
+        if suffix == "update_draft" || suffix == "publish" { assert_eq!(body["expectedDefinitionRevision"], "9007199254740993"); }
+        if suffix == "set_participation" {
+            assert_eq!(body["expectedParticipationRevision"], "9007199254740993");
+            assert_eq!(body["selections"], json!([{"categoryId":"a","content":"一"},{"categoryId":"b","content":"二"}]));
+            assert!(body.get("text").is_none() && body.get("attachments").is_none());
+        }
+        if suffix == "retract" { assert!(body.get("entryId").is_none()); }
+    }
+    let (_, cancel) = category_mode_http("im_category_chain_set_participation", json!({"channelId":cid(1),"chainId":"chain-a","expectedParticipationRevision":"2","selections":[],"clientMutationId":"cancel-mode"}));
+    assert_eq!(cancel["selections"], json!([]));
+    assert_eq!(cancel["mode"], "CATEGORY");
+}
