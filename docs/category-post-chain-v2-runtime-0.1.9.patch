+/// Legacy TEXT payloads omit mode outside create; all nine endpoints and numeric revisions are unchanged.
+#[test]
+fn post_chain_mode_v2_preserves_text_nine_actions_without_mode() {
+    for (suffix, extra, expected_extra) in [
+        ("create", json!({"title":"TEXT"}), json!({"title":"TEXT","mode":"TEXT"})),
+        ("update_draft", json!({"expectedRevision":3}), json!({"expectedRevision":3})),
+        ("publish", json!({"expectedRevision":3}), json!({"expectedRevision":3})),
+        ("append", json!({"text":"entry"}), json!({"text":"entry","attachments":[]})),
+        ("get", json!({"middleCursor":"old-cursor","limit":10}), json!({"middleCursor":"old-cursor","limit":10})),
+        ("close", json!({"expectedRevision":3}), json!({"expectedRevision":3})),
+        ("retract", json!({"entryId":"entry-a","expectedRevision":3}), json!({"entryId":"entry-a","expectedRevision":3})),
+        ("reconcile", json!({}), json!({})),
+        ("mark_read", json!({"lastEventSeq":7,"lastReadAt":1000}), json!({"lastEventSeq":7,"lastReadAt":1000})),
+    ] {
+        let mut args=json!({"channelId":cid(1),"chainId":"text-chain","clientMutationId":"text-mutation"});
+        args.as_object_mut().unwrap().extend(extra.as_object().unwrap().clone());
+        if suffix=="get" { args.as_object_mut().unwrap().remove("clientMutationId"); }
+        let cmd=helix_im::client_api::build_command(&format!("im_post_chain_{suffix}"),&serde_json::to_vec(&args).unwrap()).unwrap();
+        let effects=helix_im::outbound::handle_outbound(cmd.name.as_ref(),&cmd.payload,"http://fixture/api/cses","",None,Correlation::from_raw(1)).unwrap();
+        let (url,body)=effects.iter().find_map(|e|match e {Effect::Http { req,.. }=>Some((&req.url,serde_json::from_slice::<Value>(req.body.as_ref().unwrap()).unwrap())),_=>None}).unwrap();
+        let mut expected=json!({"channelId":cid(1),"chainId":"text-chain","clientMutationId":"text-mutation"});
+        if suffix=="get" { expected.as_object_mut().unwrap().remove("clientMutationId"); }
+        expected.as_object_mut().unwrap().extend(expected_extra.as_object().unwrap().clone());
+        assert_eq!(url, &format!("http://fixture/api/cses/post-chain/{}",suffix.replace('_',"-")));
+        assert_eq!(body, expected, "{suffix}");
+    }
+}
