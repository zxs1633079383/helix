+#[cfg(test)]
+mod query_tests {
+    use super::*;
+    /// Probe query/body disagreements without invoking any transport or publishing raw request bodies.
+    fn classify(query: &str, body: &str) -> Value {
+        category_transport(&HttpRequest {
+            method: "POST".into(),
+            url: format!("http://127.0.0.1:12345/api/cses/post-chain/get{query}"),
+            headers: vec![],
+            body: Some(Bytes::copy_from_slice(body.as_bytes())),
+        })
+    }
+    /// Duplicate/invalid/missing/escaped query and duplicate body modes cannot satisfy v3 evidence.
+    #[test]
+    fn v3_query_and_body_discriminators_are_strict() {
+        let valid = r#"{"mode":"CATEGORY","view":"mine"}"#;
+        for query in [
+            "",
+            "?mode=",
+            "?mode=TEXT",
+            "?mode=OTHER",
+            "?mode=CATEGORY&mode=CATEGORY",
+            "?mode=CATEGORY&%6dode=CATEGORY",
+            "?mode=%",
+            "?mode=%GG",
+            "?mode=CATEGORY;extra=1",
+        ] {
+            let row = classify(query, valid);
+            assert_eq!(row["action"], "other", "{query}");
+            assert_eq!(row["categoryTransportViolation"], true, "{query}");
+        }
+        for body in [
+            r#"{"view":"mine"}"#,
+            r#"{"mode":null,"view":"mine"}"#,
+            r#"{"mode":1,"view":"mine"}"#,
+            r#"{"mode":"TEXT","view":"mine"}"#,
+            r#"{"mode":"CATEGORY","mode":"CATEGORY","view":"mine"}"#,
+            r#"{"mode":"CATEGORY","\u006dode":"CATEGORY","view":"mine"}"#,
+        ] {
+            let row = classify("?mode=CATEGORY", body);
+            assert_eq!(row["action"], "other");
+            assert_eq!(row["categoryTransportViolation"], true);
+        }
+        for query in [
+            "?mode=CATEGORY",
+            "?%6dode=%43ATEGORY",
+            "?trace=private-value&mode=CATEGORY",
+        ] {
+            let row = classify(query, valid);
+            assert_eq!(row["action"], "my-participation");
+            assert_eq!(row["queryMode"], "CATEGORY");
+            assert_eq!(row["queryModeCount"], 1);
+            assert_eq!(row["querySyntaxValid"], true);
+            assert_eq!(row["categoryTransportViolation"], false);
+        }
+        let row = classify("?mode=CATEGORY&secret-token=%GG", valid);
+        assert!(!row.to_string().contains("secret-token"));
+        assert_eq!(row["querySyntaxValid"], false);
+    }
+}
