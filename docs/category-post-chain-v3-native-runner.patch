+/// Match Go query parsing's malformed escapes/semicolon rejection without logging query values.
+fn valid_query_syntax(raw: &str) -> bool {
+    let bytes = raw.as_bytes();
+    let mut i = 0;
+    while i < bytes.len() {
+        if bytes[i] == b';' {
+            return false;
+        }
+        if bytes[i] == b'%' {
+            if i + 2 >= bytes.len()
+                || !bytes[i + 1].is_ascii_hexdigit()
+                || !bytes[i + 2].is_ascii_hexdigit()
+            {
+                return false;
+            }
+            i += 3;
+        } else {
+            i += 1;
+        }
+    }
+    true
+}
+
+/// Require exactly one decoded mode=CATEGORY; retain only safe classification and count.
+fn query_discriminator(url: Option<&url::Url>) -> (&'static str, usize, bool) {
+    let Some(url) = url else {
+        return ("INVALID", 0, false);
+    };
+    let Some(raw) = url.query() else {
+        return ("MISSING", 0, true);
+    };
+    let syntax_valid = valid_query_syntax(raw);
+    let mut count = 0;
+    let mut category = false;
+    for (key, value) in url.query_pairs() {
+        if key == "mode" {
+            count += 1;
+            category = value == "CATEGORY";
+        }
+    }
+    let mode = if !syntax_valid || count > 1 || (count == 1 && !category) {
+        "INVALID"
+    } else if count == 0 {
+        "MISSING"
+    } else {
+        "CATEGORY"
+    };
+    (mode, count, syntax_valid)
+}
