
sequenceDiagram
actor U as "用户"
participant C as "Angular Composer"
participant S as "ShellService"
participant T as "Tauri Command"
participant H as "Helix ImModule"
participant D as "Native Driver"
participant L as "SQLite"
participant R as "Timeline Projector"
participant A as "Angular SurfaceRuntime"
participant G as "Go/Pulsar/PG"
participant W as "WS post"

U->>C: "点击发送"
C->>C: "普通文本立即清空输入框"
C->>S: "sendText(text)"
S->>T: "im_send_message(payload)"
T->>H: "Tick::Command(AppCommand)"
T-->>S: "AcceptedCommand(queue only)"

H->>H: "生成 temporaryId + PendingSend(Local)"
H-->>D: "Effect::Persist(P1 sending row)"
D->>L: "UPSERT message(send_status=sending)"
L-->>H: "Tick::PortReply(P1, Ok)"

H->>H: "PendingSend Local -> Sending"
H-->>D: "Effect::Persist(Timeline read)"
D->>L: "读取当前 timeline"
L-->>H: "Tick::PortReply(rows)"
H->>R: "构造 TimelineWindowVm"
R-->>A: "Frame V2: delivery=sending"
H-->>G: "Effect::Http POST posts/create"
H-->>D: "ScheduleTimer(15s)"

G-->>H: "HTTP SUCCESS / Error"
H-->>D: "Persist sent 或 unsend"
D->>L: "更新 message"
L-->>H: "terminal PersistOk"
H->>L: "再次读取 timeline"
L-->>H: "终态 rows"
H-->>A: "Frame V2: sent 或 failed"

G-->>W: "PG commit 后发布 post"
W-->>H: "Tick::Inbound(post)"
H->>L: "按 temporaryId 补 serverId/eventSeq"
H-->>A: "可能再发 timeline/dialog Frame"
