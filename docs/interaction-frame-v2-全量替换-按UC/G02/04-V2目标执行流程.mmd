flowchart TD
    A["发送者操作或服务端事实"] --> B["Frame 投影的 `ActionBinding(message.create)`"]
    B --> C["`SurfaceActionRequested` 或主机观察输入"]
    C --> D["opaque `actionRef + input`"]
    D --> E["`ActionInvocationEnvelope`"]
    E --> F["`Tick` 确定性决策"]
    F --> G["`Effect`"]
    G --> H["Go authority"]
    H --> I["`PersistAtomic`"]
    I --> J{"`PersistOk`？"}
    J -- "否" --> X["保留旧 VM，回执失败，可重试"]
    J -- "是" --> K["`SurfaceComposer`"]
    K --> L["`InteractionFrameV2`"]
    L --> M["V2 codec 整帧验证"]
    M --> N{"revision 与 `surfaceEpoch` 合法？"}
    N -- "否" --> Y["请求 resync，保留最后一致视图"]
    N -- "是" --> O["`SurfaceRuntime` 原子替换"]
    O --> P["专属 adapter → message-ui-composer、message-document-content"]
    P --> Q["提交后执行 `UiDirective`"]
    Q --> R["`FrameApplied/ActionReceipt`"]
