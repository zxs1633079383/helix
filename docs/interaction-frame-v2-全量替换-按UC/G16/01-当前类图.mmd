classDiagram
direction LR

class MessageV4 {
  +intent()
  +renderTypedVm()
}
class CommandIngress {
  +commands: im_channel_close, im_channel_leave, im_channel_change_display_name, im_channel_change_notice, im_channel_change_info
}
class ImModule {
  +handle()
  +produceEffects()
}
class PersistBarrier {
  +contracts: channel, channel_member
}
class InteractionFrameV2 {
  +schemaVersion: 2
  +surfaces: message.channel-summary, message.member-roster
}
class SurfaceRuntime {
  +stage()
  +atomicApply()
  +frameApplied()
}

MessageV4 --> CommandIngress : intent
CommandIngress --> ImModule : command/inbound
ImModule --> PersistBarrier : Effect
PersistBarrier --> InteractionFrameV2 : committed facts
InteractionFrameV2 --> SurfaceRuntime : opaque frame
SurfaceRuntime --> MessageV4 : typed VM
