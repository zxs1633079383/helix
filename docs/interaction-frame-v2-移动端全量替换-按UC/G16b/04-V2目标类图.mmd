  Page --> ReadonlySurface
  ReadonlySurface --> HostAction
  GateRole --> HostAction
  HostAction --> MobileSdk
  MobileSdk --> SurfaceRuntime
  MobileSdk --> CoreBridge
  CoreBridge --> HelixAuthority
  HelixAuthority --> Frame
  Frame *-- Mutations
  Mutations *-- Vm
  Frame --> SurfaceRuntime
