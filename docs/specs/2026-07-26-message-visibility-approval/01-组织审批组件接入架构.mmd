flowchart TB
    U["用户提交消息<br/>目标部门 / 指定人员"]

    subgraph MSG["消息域｜内容与投递"]
        G{"开关 / 策略"}
        D["待审内容<br/>revision + digest"]
        C["完成事件<br/>回查审批状态"]
        V["实时解析成员<br/>生成 viewers"]
        P["幂等投递"]
    end

    subgraph APPROVAL["组织域｜通用审批组件（推荐）"]
        W["创建审批实例"]
        N["节点激活<br/>动态解析审批人"]
        A["逐级 N / 会签 / 或签<br/>拒绝 / 退回 / 转交"]
        E["审批完成事件"]
    end

    subgraph ORG["组织域｜组织事实"]
        O["任职 / 多上级<br/>部门负责人 / 部门成员"]
        OE["组织变更事件"]
    end

    R["PC / Flutter / Web<br/>渲染权威状态"]

    U --> G
    G -->|"免审"| V
    G -->|"需审批 / 未命中"| D
    D --> W
    W --> N
    N <-->|"每节点查询"| O
    N --> A
    OE -.->|"触发当前节点重查"| N
    A -->|"全部分支通过"| E
    E --> C
    C -->|"状态、digest 一致"| V
    V <-->|"投递时查询成员"| O
    V --> P
    P --> R

    classDef message fill:#e8f3ff,stroke:#3973a8,color:#142536;
    classDef approval fill:#fff3d9,stroke:#aa721f,color:#33220b;
    classDef org fill:#e9f7ec,stroke:#3d8250,color:#183420;
    class G,D,C,V,P message;
    class W,N,A,E approval;
    class O,OE org;
