{
  "schemaVersion": 1,
  "uid": "helix-runtime-performance-pre",
  "title": "Helix 运行时性能 / PRE",
  "datasourceUid": "prometheus",
  "variables": [
    "datasource",
    "service",
    "platform",
    "scenario",
    "channel_shape",
    "stage",
    "operation",
    "rate_window"
  ],
  "requiredMetrics": [
    {"name": "helix_operations_total", "kind": "counter", "row": "00 总览"},
    {"name": "helix_errors_total", "kind": "counter", "row": "00 总览"},
    {"name": "helix_core_step_duration_seconds", "kind": "histogram", "row": "10 Core 与 Effect"},
    {"name": "helix_tick_queue_wait_seconds", "kind": "histogram", "row": "20 队列与调度"},
    {"name": "helix_tick_queue_depth", "kind": "gauge", "row": "20 队列与调度"},
    {"name": "helix_tick_queue_capacity", "kind": "gauge", "row": "20 队列与调度"},
    {"name": "helix_effects_per_tick", "kind": "histogram", "row": "10 Core 与 Effect"},
    {"name": "helix_effect_bytes_per_tick", "kind": "histogram", "row": "10 Core 与 Effect"},
    {"name": "helix_effect_amplification_ratio", "kind": "histogram", "row": "10 Core 与 Effect"},
    {"name": "helix_http_queue_wait_seconds", "kind": "histogram", "row": "30 HTTP"},
    {"name": "helix_http_request_duration_seconds", "kind": "histogram", "row": "30 HTTP"},
    {"name": "helix_http_inflight", "kind": "gauge", "row": "30 HTTP"},
    {"name": "helix_persist_queue_wait_seconds", "kind": "histogram", "row": "20 队列与调度"},
    {"name": "helix_storage_tx_duration_seconds", "kind": "histogram", "row": "50 Storage 与 PortReply"},
    {"name": "helix_storage_rows_total", "kind": "counter", "row": "50 Storage 与 PortReply"},
    {"name": "helix_port_roundtrip_seconds", "kind": "histogram", "row": "50 Storage 与 PortReply"},
    {"name": "helix_ws_ingress_to_effect_seconds", "kind": "histogram", "row": "40 WebSocket"},
    {"name": "helix_ws_ingress_to_event_seconds", "kind": "histogram", "row": "40 WebSocket"},
    {"name": "helix_command_to_projection_seconds", "kind": "histogram", "row": "60 Event 与 Projection"},
    {"name": "helix_event_lagged_total", "kind": "counter", "row": "60 Event 与 Projection"},
    {"name": "helix_event_no_receiver_total", "kind": "counter", "row": "60 Event 与 Projection"},
    {"name": "helix_event_batch_size", "kind": "histogram", "row": "60 Event 与 Projection"},
    {"name": "helix_ffi_batch_events", "kind": "histogram", "row": "70 FFI"},
    {"name": "helix_ffi_batch_bytes", "kind": "histogram", "row": "70 FFI"},
    {"name": "helix_ffi_callback_duration_seconds", "kind": "histogram", "row": "70 FFI"},
    {"name": "helix_ffi_busy_total", "kind": "counter", "row": "70 FFI"},
    {"name": "helix_alloc_count_per_op", "kind": "histogram", "row": "80 分配与生命周期"},
    {"name": "helix_alloc_bytes_per_op", "kind": "histogram", "row": "80 分配与生命周期"},
    {"name": "helix_process_resident_memory_bytes", "kind": "gauge", "row": "80 分配与生命周期"},
    {"name": "helix_shutdown_drain_seconds", "kind": "histogram", "row": "80 分配与生命周期"},
    {"name": "helix_metrics_queue_depth", "kind": "gauge", "row": "90 遥测流水线"},
    {"name": "helix_metrics_queue_capacity", "kind": "gauge", "row": "90 遥测流水线"},
    {"name": "helix_metrics_dropped_total", "kind": "counter", "row": "90 遥测流水线"},
    {"name": "helix_metrics_export_batch_size", "kind": "histogram", "row": "90 遥测流水线"},
    {"name": "helix_metrics_export_duration_seconds", "kind": "histogram", "row": "90 遥测流水线"},
    {"name": "helix_metrics_export_errors_total", "kind": "counter", "row": "90 遥测流水线"},
    {"name": "helix_metrics_exporter_state", "kind": "gauge", "row": "90 遥测流水线"},
    {"name": "helix_metrics_last_success_age_seconds", "kind": "gauge", "row": "90 遥测流水线"}
  ],
  "correctnessMetrics": [
    "helix_lost_total",
    "helix_duplicate_total",
    "helix_order_violation_total",
    "helix_wrong_channel_total",
    "helix_cursor_regression_total",
    "helix_projection_mismatch_total",
    "helix_persist_remaining_total",
    "helix_cleanup_residue_total"
  ],
  "supportMetrics": [
    "helix_run_throughput_per_second"
  ],
  "canaryMetric": "helix_telemetry_canary_total",
  "histogramStatistics": ["P50", "P90", "P95", "P99", "AVG"],
  "counterStatistics": ["RATE", "INCREASE"],
  "gaugeStatistics": ["CURRENT", "AVG", "MAX"]
}
