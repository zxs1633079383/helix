    {
      "id": 13,
      "title": "业务 Command 终态成功率",
      "description": "Go 业务 Command 的真实 terminal success / 全部 terminal；按 operation 独立展示，不包含 accepted/rejected admission。",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "无真实终态数据",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, environment, operation) (increase(im_business_command_terminal_total{job=~\"$go_job\",environment=~\"$go_environment\",result=\"success\"}[1h]) and on(job, environment, instance) (up == 1)) / sum by (job, environment, operation) (increase(im_business_command_terminal_total{job=~\"$go_job\",environment=~\"$go_environment\"}[1h]) and on(job, environment, instance) (up == 1))",
          "instant": true,
          "legendFormat": "业务 Command 终态成功率"
        }
      ]
    },
    {
      "id": 14,
      "title": "远端消息落库量 / 秒",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "新增消息/秒只统计 outcome=inserted；幂等命中单列，不冒充物理新增。事务成功/秒用于观察旧版本或全量提交吞吐。",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "无采集样本",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "im:message_remote_persist_inserted_per_second{job=~\"$go_job\",environment=~\"$go_environment\"}",
          "legendFormat": "{{environment}} 真实新增消息/秒"
        },
        {
          "refId": "B",
          "expr": "im:message_remote_persist_deduplicated_per_second{job=~\"$go_job\",environment=~\"$go_environment\"}",
          "legendFormat": "{{environment}} 幂等命中/秒"
        },
        {
          "refId": "C",
          "expr": "sum by (job, environment) (rate(im_message_persist_terminal_total{job=~\"$go_job\",environment=~\"$go_environment\",result=\"success\"}[5m]) and on(job, environment, instance) (up == 1))",
          "legendFormat": "{{environment}} 成功事务/秒"
        }
      ]
    },
