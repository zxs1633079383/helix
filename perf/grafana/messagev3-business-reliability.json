  "templating": {
    "list": [
      {
        "name": "go_job",
        "label": "GoServer job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(im_send_inflight, job)",
          "refId": "go-job"
        },
        "current": {
          "selected": false,
          "text": ".*",
          "value": ".*"
        },
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      },
      {
