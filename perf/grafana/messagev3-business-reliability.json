        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "im:message_persist_success_ratio{job=~\"$go_job\"}",
          "legendFormat": "消息远端落库成功率"
