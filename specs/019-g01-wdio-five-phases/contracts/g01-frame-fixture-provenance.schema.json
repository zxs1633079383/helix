{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "g01-frame-fixture-provenance.schema.json",
  "title": "G01 Frame V2 Fixture Provenance Manifest",
  "type": "array",
  "minItems": 3,
  "maxItems": 3,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "fixtureId",
      "schemaVersion",
      "helixCommit",
      "producer",
      "sourceKind",
      "semanticSha256",
      "fixtureSha256",
      "surfaces",
      "generatedAt",
      "parameterizableFields",
      "placeholderValues"
    ],
    "properties": {
      "fixtureId": {
        "enum": ["g01-sending-v2", "g01-sent-v2", "g01-failed-v2"]
      },
      "schemaVersion": { "const": 2 },
      "helixCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
      "producer": { "type": "string", "minLength": 1 },
      "sourceKind": { "enum": ["rust-export", "real-capture"] },
      "semanticSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "fixtureSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "surfaces": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^message\\." }
      },
      "generatedAt": { "type": "string", "format": "date-time" },
      "parameterizableFields": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^/" }
      },
      "placeholderValues": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channelId",
          "marker",
          "messageId",
          "postId",
          "reqId",
          "temporaryId",
          "transactionId"
        ],
        "properties": {
          "channelId": { "type": "string", "minLength": 1 },
          "marker": { "type": "string", "minLength": 1 },
          "messageId": { "type": "string", "minLength": 1 },
          "postId": { "type": "string", "minLength": 1 },
          "reqId": { "type": "string", "minLength": 1 },
          "temporaryId": { "type": "string", "minLength": 1 },
          "transactionId": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
