{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix-im/gate-inbound.schema.json",
  "title": "Helix Gate Inbound Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "ticks",
    "remote_basis"
  ],
  "properties": {
    "schema_version": {
      "const": "helix-im-gate-inbound/v1"
    },
    "gate_id": {
      "type": "string",
      "pattern": "^G-(?:S[1-4]|[0-9]{2}[a-z]?)$"
    },
    "ticks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value", "now_ms"],
        "properties": {
          "kind": {
            "enum": ["Command", "Inbound", "PortReply", "Timer"]
          },
          "value": {},
          "now_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "remote_basis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["table", "columns"],
        "properties": {
          "table": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
