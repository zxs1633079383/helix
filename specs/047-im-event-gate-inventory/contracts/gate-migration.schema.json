{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix-im/gate-migration.schema.json",
  "title": "MessageV3 Gate Migration Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_id",
    "phase",
    "state",
    "test_package",
    "test_target",
    "test_path",
    "generated_files",
    "legacy_inventory",
    "verification"
  ],
  "properties": {
    "gate_id": {
      "type": "string",
      "pattern": "^G-(?:S[1-4]|[0-9]{2}[a-z]?)$"
    },
    "phase": { "enum": ["P1", "P2", "P3", "P4", "P5", "P6"] },
    "state": {
      "enum": [
        "PLANNED",
        "TEST_RED",
        "MESSAGE_V3_GREEN",
        "LEGACY_REMOVED",
        "MIGRATED",
        "BLOCKED"
      ]
    },
    "test_package": {
      "enum": ["post", "schedule", "timeline", "read", "channel", "sync"]
    },
    "test_target": {
      "type": "string",
      "pattern": "^message_v3_(?:g|gs)[0-9]+[a-z]?$"
    },
    "test_path": {
      "type": "string",
      "pattern": "^crates/helix-im/tests/message_v3/(?:post|schedule|timeline|read|channel|sync)/(?:g|gs)[0-9]+[a-z]?/main\\.rs$"
    },
    "generated_files": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "legacy_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "disposition", "evidence"],
        "properties": {
          "kind": { "type": "string" },
          "path": { "type": "string" },
          "disposition": { "enum": ["removed", "N/A"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
